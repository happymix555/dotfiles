[
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-e": "project_panel::ToggleFocus",
      "cmd-shift-g": "git_panel::ToggleFocus",
      "cmd-shift-a": "agent::ToggleFocus",
      "cmd-`": "terminal_panel::Toggle"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": { "cmd-shift-e": "workspace::CloseActiveDock" }
  },
  {
    "context": "GitPanel",
    "bindings": { "cmd-shift-g": "workspace::CloseActiveDock" }
  },
  {
    "context": "AgentPanel",
    "bindings": { "cmd-shift-a": "workspace::CloseActiveDock" }
  },
  {
    "context": "Terminal",
    "bindings": { "cmd-`": "terminal_panel::Toggle" }
  }
]
